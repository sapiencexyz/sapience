{
  "name": "docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vocs dev",
    "build:vocs": "vocs build",
    "build:storybook": "cd ../ui && pnpm build-storybook && mkdir -p ../docs/docs/public && cp -r storybook-static ../docs/docs/public/components-storybook",
    "build": "pnpm --filter @sapience/sdk run build:lib && pnpm generate && pnpm build:storybook && pnpm build:vocs",
    "preview": "vocs preview",
    "generate": "pnpm generate:addresses && pnpm generate:auction-types",
    "generate:addresses": "node scripts/generate-addresses.mjs",
    "generate:auction-types": "node scripts/generate-auction-types.mjs",
    "generate:check": "node scripts/generate-addresses.mjs --check && node scripts/generate-auction-types.mjs --check"
  },
  "dependencies": {
    "@vercel/analytics": "1.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vocs": "1.4.1"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.9.2"
  }
}
