# Per-pool fairness secret (32-byte hex). Rotate with every new pool;
# keccak256 of it is published at /pool, the secret itself is revealed at
# /fairness once the cutoff passes. Generate: openssl rand -hex 32
SERVER_SECRET=0x...

# Bearer token for /admin/* endpoints.
ADMIN_TOKEN=change-me

PORT=3200
POOL_PATH=pool.json
DATA_DIR=data
RELAYER_WS_URL=wss://relayer.staging.sapience.xyz/auction
# ZERODEV_PROJECT_ID defaults to the bingo staging project
