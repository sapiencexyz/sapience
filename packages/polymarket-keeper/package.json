{
  "name": "@sapience/polymarket-keeper",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Scripts for managing Sapience conditions from Polymarket markets",
  "scripts": {
    "build": "tsc",
    "generate": "tsx scripts/generate.ts",
    "generate:dry-run": "LLM_ENABLED=false tsx scripts/generate.ts --dry-run",
    "settle": "tsx scripts/settle.ts",
    "settle:dry-run": "tsx scripts/settle.ts --dry-run",
    "settle:execute": "tsx scripts/settle.ts --execute",
    "settle:execute:wait": "tsx scripts/settle.ts --execute --wait",
    "settle-v2": "tsx scripts/settle-v2.ts",
    "settle-v2:dry-run": "tsx scripts/settle-v2.ts --dry-run",
    "settle-v2:execute": "tsx scripts/settle-v2.ts --execute",
    "settle-v2:execute:wait": "tsx scripts/settle-v2.ts --execute --wait",
    "start": "node dist/scripts/generate.js && node dist/scripts/settle.js --execute --wait",
    "start:v2": "node dist/scripts/generate.js && node dist/scripts/settle-v2.js --execute --wait",
    "lint": "eslint src --quiet",
    "lint:fix": "eslint src --fix --quiet && pnpm format",
    "format": "prettier --write src scripts",
    "type-check": "tsc --noEmit",
    "format:check": "prettier --check src scripts"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "viem": "2.21.49"
  },
  "devDependencies": {
    "tsx": "4.19.2",
    "@eslint/js": "9.18.0",
    "@types/node": "20.17.10",
    "eslint": "9.15.0",
    "globals": "15.11.0",
    "prettier": "3.3.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.21.0"
  },
  "engines": {
    "node": ">=20.14.x",
    "pnpm": "9.x"
  }
}
