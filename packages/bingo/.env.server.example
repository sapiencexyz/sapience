# MASTER fairness secret (32-byte hex). Per-pool secrets are derived as
# keccak(master ‖ poolId) — never revealed itself; each pool's derived
# secret is revealed at /api/fairness after that pool's cutoff.
# Generate: openssl rand -hex 32
SERVER_SECRET=0x...

# Static bearer token for /api/admin/* (scripts/curl). The admin UI signs
# in with SIWE (treasury wallet) instead.
ADMIN_TOKEN=change-me

# Wallet allowed to SIWE-login as admin. Empty = receipt contract owner().
ADMIN_ADDRESS=

# BingoCardReceipt contract — REQUIRED (it is the system's database).
RECEIPT_CONTRACT_ADDRESS=0x...

# Throwaway key whose ZeroDev smart account is the receipt minter.
# Holds no funds; gas is paymaster-sponsored.
MINTER_PRIVATE_KEY=0x...

# Sponsorship (optional — "no-deposit" first card). The budget-manager EOA
# authorized to call OnboardingSponsor.setBudget — the SAME key /app uses (the
# contract has a single budgetManager). Empty disables sponsorship; the app
# then runs deposit-only. The sponsor contract address comes from the SDK
# registry per network; fund it with wUSDe (the promo bankroll) and ensure its
# matchLimit covers the per-line stake (cardPrice/10). See SPONSORSHIP_PLAN.md.
BUDGET_MANAGER_PRIVATE_KEY=

PORT=3200
# One pool object or an array of pools (last entry = active).
POOL_PATH=pool.json
RELAYER_WS_URL=wss://relayer.staging.sapience.xyz/auction
# Lower bound for on-chain log scans; defaults to the receipt deploy block.
#LOG_FROM_BLOCK=4828048
# ZERODEV_PROJECT_ID defaults to the bingo staging project
