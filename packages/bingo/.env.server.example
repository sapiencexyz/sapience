# MASTER fairness secret (32-byte hex). Per-pool secrets are derived as
# keccak(master ‖ poolId) — never revealed itself; each pool's derived
# secret is revealed at /api/fairness after that pool's cutoff.
# Generate: openssl rand -hex 32
SERVER_SECRET=0x...

# Static bearer token for /api/admin/* (scripts/curl). The admin UI signs
# in with SIWE instead.
ADMIN_TOKEN=change-me

# Treasury wallet override for SIWE admin login. Empty = receipt contract
# owner(). Sponsor budgetManager + owner are always allowed too.
ADMIN_ADDRESS=

# Comma-separated view-only admin wallets (SIWE panel access, no grant
# signing). Treasury + sponsor roles are allowed without listing them here.
ADMIN_ADDRESSES=

# Public origin the admin panel is served from (e.g. bingo.sapience.xyz).
# Binds the SIWE login message to this origin (anti-phishing replay). Empty
# skips the check — OK for local dev (Vite proxy splits origins); SET IN PROD.
ADMIN_DOMAIN=

# Throwaway key whose ZeroDev smart account is the receipt minter.
# Holds no funds; gas is paymaster-sponsored.
MINTER_PRIVATE_KEY=0x...

# Sponsorship is admin-managed — grants are wallet-signed from /admin, not
# server-side. The OnboardingSponsor address comes from the SDK registry per
# network; fund it with wUSDe. See SPONSORSHIP_ADMIN_PLAN.md.

PORT=3200
# One pool object or an array of pools (last entry = active).
POOL_PATH=pool.json
RELAYER_WS_URL=wss://relayer.staging.sapience.xyz/auction
# ZERODEV_PROJECT_ID defaults to the bingo staging project
