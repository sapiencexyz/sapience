{
  "name": "@sapience/sdk",
  "version": "0.2.0",
  "license": "MIT",
  "private": false,
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "boilerplates/README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./auction/signing": {
      "types": "./dist/auction/signing.d.ts",
      "import": "./dist/auction/signing.mjs",
      "require": "./dist/auction/signing.js"
    },
    "./auction/encoding": {
      "types": "./dist/auction/encoding.d.ts",
      "import": "./dist/auction/encoding.mjs",
      "require": "./dist/auction/encoding.js"
    },
    "./auction/escrowEncoding": {
      "types": "./dist/auction/escrowEncoding.d.ts",
      "import": "./dist/auction/escrowEncoding.mjs",
      "require": "./dist/auction/escrowEncoding.js"
    },
    "./auction/escrowSigning": {
      "types": "./dist/auction/escrowSigning.d.ts",
      "import": "./dist/auction/escrowSigning.mjs",
      "require": "./dist/auction/escrowSigning.js"
    },
    "./auction/secondarySigning": {
      "types": "./dist/auction/secondarySigning.d.ts",
      "import": "./dist/auction/secondarySigning.mjs",
      "require": "./dist/auction/secondarySigning.js"
    },
    "./relayer/auctionWs": {
      "types": "./dist/relayer/auctionWs.d.ts",
      "import": "./dist/relayer/auctionWs.mjs",
      "require": "./dist/relayer/auctionWs.js"
    },
    "./relayer/escrowAuctionWs": {
      "types": "./dist/relayer/escrowAuctionWs.d.ts",
      "import": "./dist/relayer/escrowAuctionWs.mjs",
      "require": "./dist/relayer/escrowAuctionWs.js"
    },
    "./abis": {
      "types": "./dist/abis/index.d.ts",
      "import": "./dist/abis/index.mjs",
      "require": "./dist/abis/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.mjs",
      "require": "./dist/constants/index.js"
    },
    "./queries": {
      "types": "./dist/queries/index.d.ts",
      "import": "./dist/queries/index.mjs",
      "require": "./dist/queries/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./types/v2": {
      "types": "./dist/types/v2.d.ts",
      "import": "./dist/types/v2.mjs",
      "require": "./dist/types/v2.js"
    },
    "./types/secondary": {
      "types": "./dist/types/secondary.d.ts",
      "import": "./dist/types/secondary.mjs",
      "require": "./dist/types/secondary.js"
    },
    "./types/graphql": {
      "types": "./dist/types/graphql.d.ts",
      "import": "./dist/types/graphql.mjs",
      "require": "./dist/types/graphql.js"
    },
    "./contracts/addresses": {
      "types": "./dist/contracts/addresses.d.ts",
      "import": "./dist/contracts/addresses.mjs",
      "require": "./dist/contracts/addresses.js"
    },
    "./queries/client/graphqlClient": {
      "types": "./dist/queries/client/graphqlClient.d.ts",
      "import": "./dist/queries/client/graphqlClient.mjs",
      "require": "./dist/queries/client/graphqlClient.js"
    },
    "./queries/abis/erc20abi.json": "./queries/abis/erc20abi.json",
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.mjs",
      "require": "./dist/contracts/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.mjs",
      "require": "./dist/session/index.js"
    },
    "./boilerplates": "./boilerplates/README.md"
  },
  "scripts": {
    "prepare": "pnpm run build:lib",
    "dev": "tsup index.ts auction/signing.ts auction/encoding.ts auction/escrowEncoding.ts auction/escrowSigning.ts auction/secondarySigning.ts relayer/auctionWs.ts relayer/escrowAuctionWs.ts abis/index.ts constants/index.ts contracts/index.ts contracts/addresses.ts queries/index.ts queries/client/graphqlClient.ts types/index.ts types/escrow.ts types/secondary.ts types/graphql.ts session/index.ts --format cjs,esm --dts --watch",
    "build:lib": "tsup index.ts auction/signing.ts auction/encoding.ts auction/escrowEncoding.ts auction/escrowSigning.ts auction/secondarySigning.ts relayer/auctionWs.ts relayer/escrowAuctionWs.ts abis/index.ts constants/index.ts contracts/index.ts contracts/addresses.ts queries/index.ts queries/client/graphqlClient.ts types/index.ts types/escrow.ts types/secondary.ts types/graphql.ts session/index.ts --format cjs,esm --dts --tsconfig tsconfig.build.json",
    "build": "pnpm run build:lib",
    "lint": "eslint . --quiet",
    "type-check": "tsc --noEmit",
    "settle:pyth": "tsx scripts/settlePythMarkets.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "abitype": "1.0.8",
    "graphql-request": "7.2.0",
    "zod": "3.25.1"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    },
    "@zerodev/sdk": {
      "optional": true
    },
    "@zerodev/ecdsa-validator": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@types/node": "22.14.0",
    "@types/react": "19.1.8",
    "@types/ws": "8.5.10",
    "@zerodev/ecdsa-validator": "5.3.3",
    "@zerodev/sdk": "5.4.5",
    "eslint": "9.31.0",
    "eslint-plugin-import": "2.32.0",
    "tsup": "8.5.0",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.21.0",
    "viem": "2.23.5",
    "wagmi": "2.14.16"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.x",
    "@zerodev/ecdsa-validator": "5.3.3",
    "@zerodev/sdk": "5.4.5",
    "lucide-react": "0.461.0",
    "react": ">=18 || 19",
    "react-dom": ">=18 || 19",
    "react-hook-form": "7.53.0",
    "viem": "2.23.5",
    "wagmi": "2.14.16",
    "ws": "8.18.0"
  },
  "engines": {
    "node": ">=20.14.x",
    "pnpm": "9.x"
  }
}
