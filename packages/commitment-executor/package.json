{
  "name": "@sapience/commitment-executor",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Keeper that races the relayer-mirror feed to execute (and sweep-expire) committed intents on-chain. Presence of this service is the committed-intent feature flag.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --quiet",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@sapience/sdk": "workspace:*",
    "dotenv": "16.4.5",
    "envalid": "8.1.1",
    "prom-client": "15.1.3",
    "viem": "2.47.2",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/ws": "8.18.1",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "vitest": "3.0.0"
  },
  "engines": {
    "node": ">=22.x",
    "pnpm": "9.x"
  }
}
