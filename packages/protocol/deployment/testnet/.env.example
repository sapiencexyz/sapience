# Secrets for the Robinhood testnet (chain 46630) protocol deploy.
# Copy to `.env` in this directory and fill in. `.env` is gitignored.
#
# The deployer EOA must hold native gas on Robinhood testnet, and its address
# must match PM_NETWORK_DEPLOYER_ADDRESS / DEPLOYER_ADDRESS in config.json
# (manifest:apply validates this via `cast wallet address` before deploying).

PM_NETWORK_DEPLOYER_PRIVATE_KEY=0x

# Optional: override any config.json value here (process.env wins over config.json).
# PM_NETWORK_RPC_URL=https://rpc.testnet.chain.robinhood.com
