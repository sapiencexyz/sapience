{
  "env": "robinhood-mainnet",
  "chain": {
    "name": "Robinhood Mainnet",
    "chainId": 0,
    "rpcUrlEnv": "PM_NETWORK_RPC_URL",
    "deployerPrivateKeyEnv": "PM_NETWORK_DEPLOYER_PRIVATE_KEY",
    "deployerAddressEnv": "PM_NETWORK_DEPLOYER_ADDRESS",
    "verifier": {
      "kind": "blockscout",
      "explorerUrlEnv": "PM_NETWORK_EXPLORER_URL"
    }
  },
  "bundle": "mainnet",
  "bridgeEnabled": true,
  "units": {
    "ManualConditionResolver": {
      "name": "ManualConditionResolver",
      "contract": "ManualConditionResolver",
      "contractPath": "src/resolvers/mocks/ManualConditionResolver.sol:ManualConditionResolver",
      "script": "src/scripts/deploy/DeployResolver.s.sol:DeployResolver",
      "produces": ["RESOLVER_ADDRESS"],
      "constructorDeps": [],
      "wiringPeers": [],
      "configureScripts": [],
      "sdkExport": "manualConditionResolver",
      "notes": "SCAFFOLD — chainId is a placeholder (0). Set the real Robinhood mainnet chain id + config before running manifest:apply --bundle mainnet."
    },
    "PredictionMarketTokenFactory": {
      "name": "PredictionMarketTokenFactory",
      "contract": "PredictionMarketTokenFactory",
      "contractPath": "src/PredictionMarketTokenFactory.sol:PredictionMarketTokenFactory",
      "script": "src/scripts/deploy/DeployFactory.s.sol:DeployFactory",
      "produces": ["FACTORY_ADDRESS"],
      "constructorDeps": [],
      "stateInvalidatedBy": ["PredictionMarketEscrow"],
      "wiringPeers": [],
      "twinOf": "arbitrum:PredictionMarketTokenFactory",
      "configureScripts": [
        "src/scripts/deploy/ConfigureFactory.s.sol:ConfigureFactory"
      ],
      "sdkExport": "predictionMarketTokenFactory",
      "notes": "CREATE2 twin of arbitrum:PredictionMarketTokenFactory — same deployer EOA + same FACTORY_SALT via the Arachnid proxy (0x4e59...4956C, must exist on Robinhood) yields the same address on both chains."
    },
    "PredictionMarketEscrow": {
      "name": "PredictionMarketEscrow",
      "contract": "PredictionMarketEscrow",
      "contractPath": "src/PredictionMarketEscrow.sol:PredictionMarketEscrow",
      "script": "src/scripts/deploy/DeployPredictionMarket.s.sol:DeployPredictionMarket",
      "produces": ["PREDICTION_MARKET_ADDRESS"],
      "constructorDeps": ["PredictionMarketTokenFactory"],
      "wiringPeers": [],
      "configureScripts": [],
      "sdkExport": "predictionMarketEscrow",
      "notes": "Takes factory + COLLATERAL_TOKEN_ADDRESS (mainnet collateral TBD) in constructor."
    },
    "SecondaryMarketEscrow": {
      "name": "SecondaryMarketEscrow",
      "contract": "SecondaryMarketEscrow",
      "contractPath": "src/SecondaryMarketEscrow.sol:SecondaryMarketEscrow",
      "script": "src/scripts/deploy/DeploySecondaryMarketEscrow.s.sol:DeploySecondaryMarketEscrow",
      "produces": ["SECONDARY_MARKET_ESCROW_ADDRESS"],
      "constructorDeps": [],
      "wiringPeers": [],
      "configureScripts": [],
      "sdkExport": "secondaryMarketEscrow",
      "notes": "Permissionless atomic OTC swap. No constructor args, no deps."
    },
    "PredictionMarketVault": {
      "name": "PredictionMarketVault",
      "contract": "PredictionMarketVault",
      "contractPath": "src/vault/PredictionMarketVault.sol:PredictionMarketVault",
      "script": "src/scripts/deploy/vault/DeployVault.s.sol:DeployVault",
      "produces": ["VAULT_ADDRESS"],
      "constructorDeps": [],
      "wiringPeers": [],
      "configureScripts": [],
      "sdkExport": "predictionMarketVault",
      "notes": "Default vault instance. Reads VAULT_MANAGER/NAME/SYMBOL env vars."
    },
    "OnboardingSponsor": {
      "name": "OnboardingSponsor",
      "contract": "OnboardingSponsor",
      "contractPath": "src/sponsors/OnboardingSponsor.sol:OnboardingSponsor",
      "script": "src/scripts/deploy/DeployOnboardingSponsor.s.sol:DeployOnboardingSponsor",
      "produces": ["ONBOARDING_SPONSOR_ADDRESS"],
      "constructorDeps": ["PredictionMarketEscrow", "PredictionMarketVault"],
      "wiringPeers": [],
      "configureScripts": [],
      "sdkExport": "onboardingSponsor",
      "notes": "Reads MAX_ENTRY_PRICE_BPS + VAULT_ADDRESS. Optional — remove this unit if not needed."
    },
    "PredictionMarketBridge": {
      "name": "PredictionMarketBridge",
      "contract": "PredictionMarketBridge",
      "contractPath": "src/bridge/PredictionMarketBridge.sol:PredictionMarketBridge",
      "script": "src/scripts/deploy/DeployEtherealBridge.s.sol:DeployEtherealBridge",
      "produces": ["PM_NETWORK_BRIDGE_ADDRESS"],
      "constructorDeps": ["PredictionMarketTokenFactory"],
      "wiringPeers": ["arbitrum:PredictionMarketBridgeRemote"],
      "configureScripts": [
        "src/scripts/deploy/ConfigureEtherealBridge.s.sol:ConfigureEtherealBridge",
        "src/scripts/deploy/SetDVN_EtherealBridge.s.sol:SetDVN_EtherealBridge"
      ],
      "sdkExport": "predictionMarketBridge",
      "notes": "PM-side LayerZero bridge, LZ peer of arbitrum:PredictionMarketBridgeRemote (Robinhood <-> Arbitrum One token bridge). Needs the PM_NETWORK_LZ_* config filled before apply."
    },
    "ConditionalTokensConditionResolver": {
      "name": "ConditionalTokensConditionResolver",
      "contract": "ConditionalTokensConditionResolver",
      "contractPath": "src/resolvers/conditionalTokens/ConditionalTokensConditionResolver.sol:ConditionalTokensConditionResolver",
      "script": "src/scripts/deploy/DeployConditionalTokensConditionResolver.s.sol:DeployConditionalTokensConditionResolver",
      "produces": ["CT_CONDITION_RESOLVER_ADDRESS"],
      "constructorDeps": [],
      "wiringPeers": ["polygon:ConditionalTokensReader"],
      "configureScripts": [
        "src/scripts/deploy/ConfigureCTResolver.s.sol:ConfigureCTResolver",
        "src/scripts/deploy/SetDVN_CTResolver.s.sol:SetDVN_CTResolver"
      ],
      "sdkExport": "conditionalTokensConditionResolver",
      "notes": "PM-side receiver of Gnosis ConditionalTokens payouts forwarded from polygon:ConditionalTokensReader via LayerZero."
    }
  }
}
