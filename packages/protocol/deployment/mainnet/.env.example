# Secrets for the Robinhood MAINNET protocol deploy (bridge ENABLED).
# Copy to `.env` in this directory and replace every REPLACE_ME_* below.
# `.env` is gitignored. Find remaining items with: grep -n REPLACE_ME .env
#
# The PM (Robinhood) and SM (Arbitrum) keys MUST derive the SAME EOA so the
# CREATE2 factory twin shares an address, and that EOA must equal
# PM_NETWORK_DEPLOYER_ADDRESS / DEPLOYER_ADDRESS / SM_NETWORK_DEPLOYER_ADDRESS
# in config.json. Fund all three deployer EOAs with native gas
# (Robinhood + Arbitrum One + Polygon).

# Robinhood (PM) + Arbitrum (SM) — SAME EOA (the CREATE2 factory twin).
PM_NETWORK_DEPLOYER_PRIVATE_KEY=REPLACE_ME_DEPLOYER_PRIVATE_KEY
SM_NETWORK_DEPLOYER_PRIVATE_KEY=REPLACE_ME_DEPLOYER_PRIVATE_KEY
# Polygon deployer (CT reader). Can be a different EOA; needs gas on Polygon.
POLYGON_DEPLOYER_PRIVATE_KEY=REPLACE_ME_POLYGON_DEPLOYER_PRIVATE_KEY

# Contract verification (Etherscan v2 keys for the SM/Polygon explorers).
SM_NETWORK_ETHERSCAN_API_KEY=REPLACE_ME_ARBISCAN_API_KEY
POLYGON_ETHERSCAN_API_KEY=REPLACE_ME_POLYGONSCAN_API_KEY

# Optional: pin the CREATE2 salt so the factory twin is reproducible across
# separate runs (otherwise apply auto-generates a per-bundle/date salt).
# FACTORY_SALT=0x...
