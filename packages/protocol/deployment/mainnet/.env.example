# Secrets for the Robinhood MAINNET protocol deploy (SCAFFOLD — chain not live yet).
# Copy to `.env` in this directory and fill in. `.env` is gitignored.
#
# The deployer EOA must hold native gas on Robinhood mainnet, and its address
# must match PM_NETWORK_DEPLOYER_ADDRESS / DEPLOYER_ADDRESS in config.json.

PM_NETWORK_DEPLOYER_PRIVATE_KEY=0x

# --- Bridge secrets (only needed once bridgeEnabled=true across the mainnet bundle) ---
# SM (Arbitrum One) deployer: for the CREATE2 factory twin to share an address, this
# key's EOA MUST equal the Robinhood (PM) deployer's EOA. Needs gas on Arbitrum One.
SM_NETWORK_DEPLOYER_PRIVATE_KEY=0x
# Polygon deployer (CT reader). Can be a different EOA; needs gas on Polygon.
POLYGON_DEPLOYER_PRIVATE_KEY=0x

# Contract verification (Etherscan v2 keys for the SM/Polygon explorers).
SM_NETWORK_ETHERSCAN_API_KEY=
POLYGON_ETHERSCAN_API_KEY=

# Optional: override any config.json value here (process.env wins over config.json).
# PM_NETWORK_RPC_URL=https://rpc.mainnet.chain.robinhood.com
