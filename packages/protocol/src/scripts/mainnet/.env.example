# Secrets only — public config is in config.json
# Copy to .env and fill in private keys

# Deployer (same key for PM + SM + Polygon networks)
PM_NETWORK_DEPLOYER_PRIVATE_KEY=0x...
SM_NETWORK_DEPLOYER_PRIVATE_KEY=0x...
POLYGON_DEPLOYER_PRIVATE_KEY=0x...

# Contract verification
SM_NETWORK_ETHERSCAN_API_KEY=
POLYGON_ETHERSCAN_API_KEY=

# Testing wallets (optional, for mint/bridge tests)
PREDICTOR_PRIVATE_KEY=0x...
COUNTERPARTY_PRIVATE_KEY=0x...
