# Test Environment Variables for Prediction Market Indexer
# Copy this file to .env and fill in your actual values

# Required: Private key for testing (without 0x prefix)
TEST_PRIVATE_KEY=your_private_key_here

# Optional: Custom RPC URL (defaults to Arbitrum mainnet)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Optional: Infura API key for WebSocket connections
INFURA_API_KEY=your_infura_api_key_here

# Optional: Custom contract addresses
PREDICTION_MARKET_CONTRACT_ADDRESS=0xA5d368857C39267966f2096C4Fb509F3094E4E4a
TEST_RESOLVER_ADDRESS=0xA0B6d6fd2Fe9E14A34DA49Ca4de7426F6b65667c

# Optional: Database configuration
DATABASE_URL=your_database_url_here

# Optional: Test market configuration
TEST_MARKET_GROUP_ADDRESS=your_market_group_address_here
TEST_MARKET_ID=1