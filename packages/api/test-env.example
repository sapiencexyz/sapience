# Test Environment Variables for Prediction Market Indexer
# Copy this file to .env and fill in your actual values

# Required: Private key for testing (without 0x prefix)
TEST_PRIVATE_KEY=your_private_key_here

# Optional: Infura API key for WebSocket connections
INFURA_API_KEY=your_infura_api_key_here

# Optional: Database configuration
DATABASE_URL=your_database_url_here

# Contract test suite
# - TEST_DATABASE_URL points at a dedicated local Postgres used by
#   `pnpm test:contract`. Migrations are applied via `prisma migrate deploy`
#   on every contract run, then `test/fixtures/contract.sql` is loaded into it.
#   NEVER point this at a shared or production database.
TEST_DATABASE_URL=postgresql://localhost:5432/sapience_test
# - SNAPSHOT_DATABASE_URL is a read-only URL used only by
#   `pnpm snapshot-test-db` to build contract.sql. Used outside of test runs.
SNAPSHOT_DATABASE_URL=your_readonly_source_db_url_here