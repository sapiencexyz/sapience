{
  "name": "@sapience/market-keeper",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Scripts for managing Sapience conditions from Polymarket markets",
  "scripts": {
    "build": "tsc",
    "generate": "tsx scripts/generate.ts",
    "generate:dry-run": "LLM_ENABLED=false tsx scripts/generate.ts --dry-run",
    "add-events": "tsx scripts/add-events.ts",
    "add-events:dry-run": "LLM_ENABLED=false tsx scripts/add-events.ts --dry-run",
    "settle-polymarket": "tsx scripts/settle-polymarket.ts",
    "settle-polymarket:dry-run": "tsx scripts/settle-polymarket.ts --dry-run",
    "settle-polymarket:execute": "tsx scripts/settle-polymarket.ts --execute",
    "settle-polymarket:execute:wait": "tsx scripts/settle-polymarket.ts --execute --wait",
    "settle-pyth": "tsx scripts/settle-pyth.ts",
    "settle-pyth:dry-run": "tsx scripts/settle-pyth.ts --dry-run",
    "settle-pyth:execute": "tsx scripts/settle-pyth.ts --execute",
    "settle-pyth:execute:wait": "tsx scripts/settle-pyth.ts --execute --wait",
    "settle-manual": "tsx scripts/settle-manual.ts",
    "settle-manual:dry-run": "tsx scripts/settle-manual.ts --dry-run",
    "settle-manual:execute": "tsx scripts/settle-manual.ts --execute",
    "settle-manual:execute:wait": "tsx scripts/settle-manual.ts --execute --wait",
    "relist": "tsx scripts/relist.ts",
    "relist:dry-run": "LLM_ENABLED=false tsx scripts/relist.ts --dry-run",
    "prices-and-1d-7d-volume": "tsx scripts/prices-and-1d-7d-volume.ts",
    "prices-and-1d-7d-volume:dry-run": "tsx scripts/prices-and-1d-7d-volume.ts --dry-run",
    "refresh-volume": "tsx scripts/refresh-volume.ts",
    "refresh-volume:dry-run": "tsx scripts/refresh-volume.ts --dry-run",
    "refresh-metadata": "tsx scripts/refresh-metadata.ts",
    "refresh-metadata:dry-run": "tsx scripts/refresh-metadata.ts --dry-run",
    "smoke-endtime-llm": "tsx scripts/smoke-endtime-llm.ts",
    "labeler:fetch": "tsx src/labeler/fetch.ts",
    "labeler:fetch-weather": "tsx src/labeler/fetch-weather.ts",
    "labeler:fetch-sports": "tsx src/labeler/fetch-sports.ts",
    "labeler:validate-game": "tsx src/labeler/validate-game.ts",
    "labeler:fetch-llm-endtimes": "tsx src/labeler/fetch-llm-endtimes.ts",
    "labeler:serve": "tsx src/labeler/serve.ts",
    "labeler:score": "tsx src/labeler/score.ts",
    "cleanup-polymarket": "tsx scripts/cleanup-polymarket.ts",
    "cleanup-polymarket:dry-run": "tsx scripts/cleanup-polymarket.ts --dry-run",
    "cleanup-polymarket:execute": "tsx scripts/cleanup-polymarket.ts --execute",
    "start": "node scripts/start.js",
    "start:discovery": "node scripts/cron-discovery.js",
    "start:metadata-tags": "node scripts/cron-metadata-tags.js",
    "start:market-data": "node scripts/cron-market-data.js",
    "start:settlement": "node scripts/cron-settlement.js",
    "start:status": "node scripts/cron-status.js",
    "keeper-status": "tsx scripts/keeper-status.ts",
    "lint": "eslint src --quiet",
    "lint:fix": "eslint src --fix --quiet && pnpm format",
    "format": "prettier --write src scripts",
    "type-check": "tsc --noEmit",
    "format:check": "prettier --check src scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@sapience/sdk": "workspace:*",
    "chrono-node": "^2.9.1",
    "dotenv": "16.4.5",
    "viem": "2.47.2"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/node": "20.17.10",
    "eslint": "9.15.0",
    "eslint-plugin-import": "2.32.0",
    "globals": "15.11.0",
    "prettier": "3.3.3",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.21.0",
    "vitest": "3.0.0"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10.16.0 <11"
  }
}
