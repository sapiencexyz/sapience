# Polygon RPC URL (required)
POLYGON_RPC_URL=https://polygon-rpc.com

# Private key for signing transactions (required for --execute mode)
# Must have POL for gas + LayerZero fees (~0.65 POL per settlement)
PRIVATE_KEY=0x...

# Sapience GraphQL API URL (optional, defaults to https://api.sapience.xyz/graphql)
# SAPIENCE_API_URL=https://api.sapience.xyz/graphql

# Chain ID (defaults to 5064014 / Ethereal mainnet)
CHAIN_ID=5064014

# Resolver address (defaults to LZConditionalTokensResolver on Ethereal mainnet)
# Set to ManualConditionResolver for testnet: 0x9938583eA9a6450Cc64502bDcBF76f4EEa2F9560
# RESOLVER_ADDRESS=0xdC1Fa830aD1de01f1EF603749f48bD73384286BE

# Polymarket settle script config (settle-polymarket.ts)
# RESOLVER_ADDRESS=0x9938583eA9a6450Cc64502bDcBF76f4EEa2F9560

ADMIN_PRIVATE_KEY=
LLM_ENABLED=true
# Set to 'false' to disable only short-name/category enrichment (Sonar still runs)
LLM_ENRICHMENT_ENABLED=true
# Set to 'false' to disable only LLM-based endTime search/Sonar calls (enrichment still runs)
LLM_ENDTIME_SEARCH_ENABLED=true
OPENROUTER_API_KEY=
LLM_ENDTIME_MODEL=perplexity/sonar
NODE_ENV=development

# --- Keeper Discord alerts ---
# Webhook for keeper alerts: balance heartbeat + per-cron run summaries.
# Leave empty to disable all keeper Discord notifications.
DISCORD_KEEPER_WEBHOOK=
# Alert when OpenRouter credits fall below this many USD (default 10).
OPENROUTER_MIN_CREDITS=10
# Alert when the admin wallet's POL balance falls below this many POL (default 5).
ADMIN_MIN_POL=5
# Set to 1 to only post per-cron summaries on failure (reduces noise).
KEEPER_SUMMARY_ON_FAILURE_ONLY=