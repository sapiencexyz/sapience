{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "next": {
    "entry": [
      "src/app/**/{page,layout,not-found,error,global-error,manifest,route,default,template,loading}.{ts,tsx}",
      "src/app/manifest.static.ts",
      "src/app/not-found.static.tsx",
      "next.config.js",
      "next.config.static.js",
      "next-sitemap.config.js"
    ]
  },
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/**/__tests__/**", "src/**/*.test.{ts,tsx}", "e2e/**"],
  "ignoreDependencies": [
    "tailwindcss",
    "postcss",
    "autoprefixer",
    "tailwindcss-animate"
  ]
}
