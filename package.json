{
  "name": "@sapience/monorepo",
  "version": "0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "pnpm run build:backend",
    "build:backend": "pnpm --filter @sapience/sdk run build:lib && pnpm --filter @sapience/api run prisma:generate && pnpm --filter @sapience/market-keeper run build",
    "build:web": "pnpm --filter @sapience/app run build && pnpm --filter docs run build",
    "test": "pnpm run test --recursive",
    "dev:app": "pnpm --filter @sapience/app run dev",
    "dev:docs": "pnpm --filter docs run dev",
    "dev:api": "concurrently \"NODE_ENV=development pnpm --filter api run dev:service\" \"NODE_ENV=development pnpm --filter api run dev:worker\"",
    "dev:api:service": "NODE_ENV=development pnpm --filter api run dev:service",
    "dev:api:worker": "NODE_ENV=development pnpm --filter api run dev:worker",
    "dev:relayer": "NODE_ENV=development pnpm --filter @sapience/relayer run dev",
    "start:reindex-market": "pnpm --filter api run start:reindex-market",
    "start:reindex-missing": "pnpm --filter api run start:reindex-missing",
    "start:reindex-resource": "pnpm --filter api run start:reindex-resource",
    "start:reindex-market-group-factory": "pnpm --filter api run start:reindex-market-group-factory",
    "start:reindex-eas": "pnpm --filter api run start:reindex-eas",
    "start:backfill-accuracy": "pnpm --filter api run start:backfill-accuracy",
    "start:compute-stats": "pnpm --filter api run start:compute-stats",
    "start:backfill-stats": "pnpm --filter api run start:backfill-stats",
    "check": "pnpm --filter @sapience/sdk run build:lib && pnpm --filter @sapience/api run prisma:generate && pnpm -r run lint && pnpm -r --filter=!protocol run type-check && pnpm -r --filter=!protocol run test",
    "format:check": "pnpm -r run format:check",
    "prepare": "husky"
  },
  "keywords": [],
  "devDependencies": {
    "concurrently": "8.2.2",
    "husky": "9.1.7",
    "lint-staged": "16.3.3",
    "prettier": "3.3.3"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10.16.0 <11"
  },
  "resolutions": {
    "@openzeppelin/contracts": "5.0.2"
  },
  "pnpm": {
    "overrides": {
      "typegraphql-prisma>@prisma/client": "6.10.1",
      "typegraphql-prisma>prisma": "6.10.1",
      "form-data": "4.0.4",
      "request>form-data": "4.0.4",
      "elliptic": "6.6.1",
      "protobufjs": "7.2.5",
      "zod": "3.25.76",
      "porto>zod": "4.3.6",
      "graphql": "16.12.0",
      "viem": "2.47.2",
      "wagmi": "2.19.5"
    }
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800"
}
