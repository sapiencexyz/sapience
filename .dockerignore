# Hidden from `docker build` — keeps the build context small and the layer
# cache key stable across local dev state changes.

# VCS + CI metadata
.git
.github
.husky

# Dependencies (installed inside the container)
node_modules
**/node_modules

# Local env files (injected at runtime via ECS task definition, never baked in)
.env
.env.*
!.env.example

# Build outputs (the container builds these itself)
**/dist
**/build
**/.next
**/.turbo
**/coverage
**/.nyc_output
**/*.tsbuildinfo
**/storybook-static

# Hardhat / Solidity artifacts
**/cache
**/artifacts
**/typechain
**/typechain-types
packages/protocol/deployments/outputs/13370
packages/protocol/deployments/outputs/test

# Editor / OS
.DS_Store
.vscode
.idea
*.swp
*.swo

# Logs
*.log
logs/

# Project-local junk and dev-only state
.claude
CLAUDE.local.md
dump.sql
.wrangler
.playwright-mcp
/data/
