# GraphQL/REST API for the Robinhood (Meridian) deployment.
# Leave blank to use the built-in default: https://api.predict.meridian.xyz
NEXT_PUBLIC_FOIL_API_URL=

# Relayer websocket, used for live vault share-price quotes.
# Leave blank to use the built-in default: https://relayer.predict.meridian.xyz/auction
NEXT_PUBLIC_FOIL_RELAYER_URL=

# Chain the app trades on. Defaults to Robinhood mainnet (4663);
# set to 46630 for Robinhood testnet.
NEXT_PUBLIC_DEFAULT_CHAIN_ID=

# WalletConnect project id (https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: Infura key for Ethereum mainnet ENS lookups
NEXT_PUBLIC_INFURA_API_KEY=
